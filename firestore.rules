rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }
    function usuarioRef() { return /databases/$(database)/documents/usuarios/$(request.auth.uid); }
    function usuarioExiste() { return logado() && exists(usuarioRef()); }
    function usuario() { return get(usuarioRef()); }
    function usuarioAtivo() { return usuarioExiste() && usuario().data.ativo == true; }
    function perfilRef() { return /databases/$(database)/documents/perfisAcesso/$(usuario().data.perfilId); }
    function perfilExiste() { return usuarioAtivo() && exists(perfilRef()); }
    function perfil() { return get(perfilRef()); }
    function perfilAtivo() { return perfilExiste() && perfil().data.ativo == true; }
    function administrador() { return perfilAtivo() && perfil().data.acessoTotal == true; }

    function permissao(modulo, acao) {
      return perfilAtivo() && (
        administrador() || (
          perfil().data.permissoes is map &&
          modulo in perfil().data.permissoes &&
          perfil().data.permissoes[modulo] is map &&
          acao in perfil().data.permissoes[modulo] &&
          perfil().data.permissoes[modulo][acao] == true
        )
      );
    }

    function mesmoGrupo(grupoId) { return usuarioAtivo() && usuario().data.grupoId == grupoId; }
    function acessoGlobal() { return usuarioAtivo() && ('acessoGlobal' in usuario().data) && usuario().data.acessoGlobal == true; }
    function acessoEmpresa(empresaId) {
      return usuarioAtivo() && (
        administrador() || acessoGlobal() ||
        usuario().data.empresaId == empresaId ||
        (('empresasAcesso' in usuario().data) && usuario().data.empresasAcesso is list && empresaId in usuario().data.empresasAcesso)
      );
    }
    function documentoAcessivel(dados) { return mesmoGrupo(dados.grupoId) && acessoEmpresa(dados.empresaId); }

    function podeAtribuirPerfil(perfilId) {
      return administrador() || (
        perfilId != 'administrador' &&
        exists(/databases/$(database)/documents/perfisAcesso/$(perfilId)) &&
        get(/databases/$(database)/documents/perfisAcesso/$(perfilId)).data.acessoTotal != true &&
        get(/databases/$(database)/documents/perfisAcesso/$(perfilId)).data.grupoId == usuario().data.grupoId
      );
    }

    function responsavelValido(usuarioId) {
      return exists(/databases/$(database)/documents/usuarios/$(usuarioId)) &&
        get(/databases/$(database)/documents/usuarios/$(usuarioId)).data.ativo == true &&
        get(/databases/$(database)/documents/usuarios/$(usuarioId)).data.grupoId == usuario().data.grupoId;
    }

    function fpaEditar() { return permissao('controladoria','editar'); }
    function fpaRealizado() { return fpaEditar() || permissao('controladoria','realizado') || permissao('controladoria','importar'); }
    function fpaBudget() { return fpaEditar() || permissao('controladoria','budget'); }
    function fpaForecast() { return fpaEditar() || permissao('controladoria','forecast'); }
    function fpaPremissas() { return fpaEditar() || permissao('controladoria','premissas'); }
    function fpaPlano() { return fpaEditar() || permissao('controladoria','planoContas'); }
    function fpaCentros() { return fpaEditar() || permissao('controladoria','centrosCusto'); }
    function fpaImobilizado() { return fpaEditar() || permissao('controladoria','imobilizado'); }
    function inadimplenciaVisualizar() { return fpaEditar() || permissao('controladoria','inadimplencia') || permissao('controladoria','inadimplenciaEditar'); }
    function inadimplenciaEditar() { return fpaEditar() || permissao('controladoria','inadimplenciaEditar'); }
    function consorciosVisualizar() { return fpaEditar() || permissao('controladoria','consorciosVisualizar') || permissao('controladoria','consorciosEditar'); }
    function consorciosEditar() { return fpaEditar() || permissao('controladoria','consorciosEditar'); }

    function permutasVisualizar() {
      return permissao('permutas','visualizar') ||
        permissao('permutas','cadastrar') ||
        permissao('permutas','editar') ||
        permissao('permutas','movimentar') ||
        permissao('permutas','estornar') ||
        permissao('permutas','fechar') ||
        permissao('permutas','inativar');
    }
    function permutasCadastrar() { return permissao('permutas','cadastrar'); }
    function permutasEditar() { return permissao('permutas','editar'); }
    function permutasMovimentar() { return permissao('permutas','movimentar'); }
    function permutasEstornar() { return permissao('permutas','estornar'); }
    function permutasFechar() { return permissao('permutas','fechar'); }
    function permutasInativar() { return permissao('permutas','inativar'); }

    function vendasVisualizar() {
      return permissao('vendas','visualizar') ||
        permissao('vendas','lancar') ||
        permissao('vendas','editar') ||
        permissao('vendas','vendedores') ||
        permissao('vendas','comissoes');
    }
    function vendasLancar() { return permissao('vendas','lancar'); }
    function vendasEditar() { return permissao('vendas','editar'); }
    function vendasVendedores() { return permissao('vendas','vendedores'); }
    function vendasComissoes() { return permissao('vendas','comissoes'); }
    function vendedorRef(vendedorId) { return /databases/$(database)/documents/vendedores/$(vendedorId); }
    function vendedorValidoParaVenda(dados) {
      return exists(vendedorRef(dados.vendedorId)) &&
        get(vendedorRef(dados.vendedorId)).data.grupoId == dados.grupoId &&
        get(vendedorRef(dados.vendedorId)).data.empresaId == dados.empresaId &&
        get(vendedorRef(dados.vendedorId)).data.status != 'inativo';
    }
    function regraComissaoPadraoValida(dados) {
      return vendedorValidoParaVenda(dados) &&
        dados.baseComissao == get(vendedorRef(dados.vendedorId)).data.baseComissao &&
        dados.comissaoPct == get(vendedorRef(dados.vendedorId)).data.comissaoPct;
    }
    function calculoComissaoValido(dados) {
      return dados.valor > 0 && dados.valorFaturado >= 0 && dados.valorFaturado <= dados.valor &&
        dados.comissaoPct >= 0 && dados.comissaoPct <= 100 &&
        dados.comissaoBaseValor == (dados.baseComissao == 'faturamento' ? dados.valorFaturado : dados.valor) &&
        dados.comissaoValor == dados.comissaoBaseValor * dados.comissaoPct / 100;
    }
    function statusComissaoInicialValido(dados) {
      return (dados.baseComissao == 'faturamento' && dados.valorFaturado <= 0 && dados.comissaoStatus == 'aguardando_faturamento') ||
        ((dados.baseComissao != 'faturamento' || dados.valorFaturado > 0) && dados.comissaoStatus == 'provisionada');
    }
    function vendaOperacionalValida(novo, antigo) {
      return calculoComissaoValido(novo) && (
        vendasComissoes() || (
          novo.vendedorId == antigo.vendedorId &&
          novo.vendedorNome == antigo.vendedorNome &&
          novo.baseComissao == antigo.baseComissao &&
          novo.comissaoPct == antigo.comissaoPct &&
          novo.comissaoStatus == antigo.comissaoStatus &&
          ((antigo.comissaoStatus != 'aprovada' && antigo.comissaoStatus != 'paga') || (
            novo.valor == antigo.valor &&
            novo.valorFaturado == antigo.valorFaturado &&
            novo.dataFaturamento == antigo.dataFaturamento
          ))
        )
      );
    }

    function caixaVisualizar() {
      return permissao('controladoria','visualizar') ||
        permissao('controladoria','caixaVisualizar');
    }
    function caixaLancar() { return fpaEditar() || permissao('controladoria','caixaLancar'); }
    function caixaContas() { return fpaEditar() || permissao('controladoria','caixaContas'); }
    function caixaFixos() { return fpaEditar() || permissao('controladoria','caixaFixos'); }
    function prestacaoComentar() { return fpaEditar() || permissao('controladoria','prestacaoComentar'); }
    function fechamentoGerir() { return fpaEditar() || permissao('controladoria','fechamento'); }
    function fechamentoFechar() { return fpaEditar() || permissao('controladoria','fecharCompetencia'); }

    function governancaVisualizar() {
      return permissao('governanca','visualizar') ||
        permissao('governanca','antifraude') ||
        permissao('governanca','auditar') ||
        permissao('governanca','planoAcao') ||
        permissao('governanca','validar') ||
        permissao('governanca','configurar');
    }
    function governancaConfigurar() { return permissao('governanca','configurar'); }
    function governancaAuditar() { return governancaConfigurar() || permissao('governanca','auditar') || permissao('governanca','validar'); }
    function governancaPlanoAcao() { return governancaAuditar() || permissao('governanca','planoAcao'); }
    function gerenciaUsuarios() { return permissao('usuarios','visualizar') || permissao('usuarios','cadastrar') || permissao('usuarios','editar'); }
    function usaCentroCusto() {
      return permissao('controladoria','visualizar') ||
        permissao('contratos','visualizar') ||
        permissao('almoxarifado','visualizar') ||
        permissao('cotacoes','visualizar') ||
        permissao('frota','visualizar') ||
        permutasVisualizar();
    }

    match /usuarios/{usuarioId} {
      allow read: if logado() && (
        request.auth.uid == usuarioId ||
        ((permissao('usuarios','visualizar') || permissao('planosAcao','reatribuir') || permissao('controladoria','fechamento')) && resource.data.grupoId == usuario().data.grupoId)
      );
      allow create: if permissao('usuarios','cadastrar') && request.resource.data.grupoId == usuario().data.grupoId && podeAtribuirPerfil(request.resource.data.perfilId);
      allow update: if resource.data.grupoId == usuario().data.grupoId && request.resource.data.grupoId == resource.data.grupoId && podeAtribuirPerfil(request.resource.data.perfilId) && (
        (permissao('usuarios','editar') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome','perfilId','empresaId','acessoGlobal','empresasAcesso','atualizadoEm'])) ||
        (permissao('usuarios','inativar') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ativo','atualizadoEm']))
      );
      allow delete: if false;
    }

    match /dashboardPreferencias/{usuarioId} {
      allow read: if usuarioAtivo() && request.auth.uid == usuarioId && resource.data.grupoId == usuario().data.grupoId;
      allow create: if usuarioAtivo() && request.auth.uid == usuarioId &&
        request.resource.data.usuarioId == request.auth.uid &&
        request.resource.data.grupoId == usuario().data.grupoId;
      allow update: if usuarioAtivo() && request.auth.uid == usuarioId &&
        resource.data.usuarioId == request.auth.uid &&
        request.resource.data.usuarioId == resource.data.usuarioId &&
        resource.data.grupoId == usuario().data.grupoId &&
        request.resource.data.grupoId == resource.data.grupoId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ordem','ocultos','atualizadoEm']);
      allow delete: if false;
    }

    match /perfisAcesso/{perfilId} {
      allow read: if usuarioAtivo() && (
        usuario().data.perfilId == perfilId || administrador() ||
        (permissao('perfisAcesso','visualizar') && (resource.data.acessoTotal == true || !('grupoId' in resource.data) || resource.data.grupoId == usuario().data.grupoId)) ||
        (gerenciaUsuarios() && resource.data.acessoTotal != true && resource.data.grupoId == usuario().data.grupoId)
      );
      allow create: if permissao('perfisAcesso','cadastrar') && request.resource.data.acessoTotal == false && request.resource.data.grupoId == usuario().data.grupoId;
      allow update: if perfilId != 'administrador' && resource.data.acessoTotal != true && request.resource.data.acessoTotal == false && resource.data.grupoId == usuario().data.grupoId && request.resource.data.grupoId == resource.data.grupoId && (
        (permissao('perfisAcesso','editar') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome','descricao','permissoes','atualizadoEm'])) ||
        (permissao('perfisAcesso','inativar') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ativo','atualizadoEm']))
      );
      allow delete: if false;
    }

    match /gruposEmpresariais/{grupoId} {
      allow read: if usuarioAtivo() && usuario().data.grupoId == grupoId;
      allow create: if administrador() && request.resource.data.ativo == true;
      allow update: if mesmoGrupo(grupoId) && permissao('grupoEmpresarial','editar') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome','atualizadoEm']);
      allow delete: if false;
    }

    match /empresas/{empresaId} {
      allow read: if acessoEmpresa(empresaId) && mesmoGrupo(resource.data.grupoId);
      allow create: if permissao('empresas','cadastrar') && request.resource.data.grupoId == usuario().data.grupoId;
      allow update: if mesmoGrupo(resource.data.grupoId) && request.resource.data.grupoId == resource.data.grupoId && (
        (permissao('empresas','editar') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['razaoSocial','nomeFantasia','cnpj','cnpjNumeros','atualizadoEm'])) ||
        (permissao('empresas','inativar') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ativo','atualizadoEm']))
      );
      allow delete: if mesmoGrupo(resource.data.grupoId) && permissao('empresas','excluir');
    }

    match /contratos/{id} {
      allow read: if permissao('contratos','visualizar') && documentoAcessivel(resource.data);
      allow create: if permissao('contratos','cadastrar') && documentoAcessivel(request.resource.data);
      allow update: if documentoAcessivel(resource.data) && request.resource.data.grupoId == resource.data.grupoId && request.resource.data.empresaId == resource.data.empresaId && (
        permissao('contratos','editar') ||
        (permissao('contratos','anexar') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['arquivoPrincipal','documentos','atualizadoEm']))
      );
      allow delete: if permissao('contratos','excluir') && documentoAcessivel(resource.data);
    }

    match /prestadores/{id} {
      allow read: if permissao('prestadores','visualizar') && documentoAcessivel(resource.data);
      allow create: if permissao('prestadores','cadastrar') && documentoAcessivel(request.resource.data);
      allow update: if (permissao('prestadores','editar') || permissao('prestadores','avaliar')) && documentoAcessivel(resource.data) && request.resource.data.grupoId == resource.data.grupoId && request.resource.data.empresaId == resource.data.empresaId;
      allow delete: if permissao('prestadores','excluir') && documentoAcessivel(resource.data);
    }

    match /veiculos/{id} {
      allow read: if permissao('frota','visualizar') && documentoAcessivel(resource.data);
      allow create: if permissao('frota','cadastrar') && documentoAcessivel(request.resource.data);
      allow update: if (permissao('frota','editar') || permissao('frota','obrigacoes') || permissao('frota','manutencao')) && documentoAcessivel(resource.data) && request.resource.data.grupoId == resource.data.grupoId && request.resource.data.empresaId == resource.data.empresaId;
      allow delete: if permissao('frota','excluir') && documentoAcessivel(resource.data);
    }

    match /manutencoesFrota/{id} {
      allow read: if permissao('frota','visualizar') && documentoAcessivel(resource.data);
      allow create: if (permissao('frota','manutencao') || permissao('frota','editar')) && documentoAcessivel(request.resource.data);
      allow update: if (permissao('frota','manutencao') || permissao('frota','editar')) && documentoAcessivel(resource.data) && request.resource.data.grupoId == resource.data.grupoId && request.resource.data.empresaId == resource.data.empresaId;
      allow delete: if permissao('frota','excluir') && documentoAcessivel(resource.data);
    }

    match /itensAlmoxarifado/{id} {
      allow read: if permissao('almoxarifado','visualizar') && documentoAcessivel(resource.data);
      allow create: if permissao('almoxarifado','cadastrar') && documentoAcessivel(request.resource.data);
      allow update: if documentoAcessivel(resource.data) && request.resource.data.grupoId == resource.data.grupoId && request.resource.data.empresaId == resource.data.empresaId && (
        permissao('almoxarifado','editar') || permissao('almoxarifado','ajustar') || permissao('almoxarifado','movimentar') || permissao('almoxarifado','prorrogar')
      );
      allow delete: if permissao('almoxarifado','excluir') && documentoAcessivel(resource.data);
    }

    match /movimentacoesEstoque/{id} {
      allow read: if permissao('almoxarifado','visualizar') && documentoAcessivel(resource.data);
      allow create: if permissao('almoxarifado','movimentar') && documentoAcessivel(request.resource.data);
      allow update, delete: if false;
    }

    match /cotacoes/{id} {
      allow read: if permissao('cotacoes','visualizar') && documentoAcessivel(resource.data);
      allow create: if permissao('cotacoes','solicitar') && documentoAcessivel(request.resource.data);
      allow update: if documentoAcessivel(resource.data) && request.resource.data.grupoId == resource.data.grupoId && request.resource.data.empresaId == resource.data.empresaId && (
        permissao('cotacoes','editar') || permissao('cotacoes','cotacao') || permissao('cotacoes','aprovar') || permissao('cotacoes','anexar')
      );
      allow delete: if false;
    }

    match /vendedores/{id} {
      allow read: if vendasVisualizar() && documentoAcessivel(resource.data);
      allow create: if vendasVendedores() && documentoAcessivel(request.resource.data) &&
        request.resource.data.baseComissao in ['venda','faturamento'] &&
        request.resource.data.comissaoPct >= 0 && request.resource.data.comissaoPct <= 100;
      allow update: if vendasVendedores() && documentoAcessivel(resource.data) &&
        request.resource.data.grupoId == resource.data.grupoId &&
        request.resource.data.empresaId == resource.data.empresaId &&
        request.resource.data.baseComissao in ['venda','faturamento'] &&
        request.resource.data.comissaoPct >= 0 && request.resource.data.comissaoPct <= 100;
      allow delete: if false;
    }

    match /vendas/{id} {
      allow read: if vendasVisualizar() && documentoAcessivel(resource.data);
      allow create: if vendasLancar() && documentoAcessivel(request.resource.data) &&
        vendedorValidoParaVenda(request.resource.data) &&
        calculoComissaoValido(request.resource.data) &&
        (vendasComissoes() || (
          regraComissaoPadraoValida(request.resource.data) &&
          statusComissaoInicialValido(request.resource.data)
        ));
      allow update: if documentoAcessivel(resource.data) &&
        request.resource.data.grupoId == resource.data.grupoId &&
        request.resource.data.empresaId == resource.data.empresaId && (
          (vendasEditar() && vendaOperacionalValida(request.resource.data, resource.data)) ||
          (vendasComissoes() &&
            calculoComissaoValido(request.resource.data) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'comissaoPct','comissaoBaseValor','comissaoValor','comissaoStatus','atualizadoEm'
            ]))
        );
      allow delete: if false;
    }

    match /planejamentoMensal/{id} {
      allow read: if permissao('controladoria','visualizar') && documentoAcessivel(resource.data);
      allow create: if fpaEditar() && documentoAcessivel(request.resource.data);
      allow update: if fpaEditar() && documentoAcessivel(resource.data) && request.resource.data.grupoId == resource.data.grupoId && request.resource.data.empresaId == resource.data.empresaId;
      allow delete: if false;
    }

    match /centrosCusto/{id} {
      allow read: if usaCentroCusto() && documentoAcessivel(resource.data);
      allow create: if fpaCentros() && documentoAcessivel(request.resource.data);
      allow update: if fpaCentros() && documentoAcessivel(resource.data) && request.resource.data.grupoId == resource.data.grupoId && request.resource.data.empresaId == resource.data.empresaId;
      allow delete: if false;
    }

    match /planoContasGerencial/{id} {
      allow read: if (permissao('controladoria','visualizar') || permutasVisualizar()) && documentoAcessivel(resource.data);
      allow create: if fpaPlano() && documentoAcessivel(request.resource.data);
      allow update: if fpaPlano() && documentoAcessivel(resource.data) && request.resource.data.grupoId == resource.data.grupoId && request.resource.data.empresaId == resource.data.empresaId;
      allow delete: if fpaPlano() && documentoAcessivel(resource.data);
    }

    match /imobilizados/{id} {
      allow read: if permissao('controladoria','visualizar') && documentoAcessivel(resource.data);
      allow create: if fpaImobilizado() && documentoAcessivel(request.resource.data);
      allow update: if fpaImobilizado() && documentoAcessivel(resource.data) && request.resource.data.grupoId == resource.data.grupoId && request.resource.data.empresaId == resource.data.empresaId;
      allow delete: if false;
    }

    match /consorcios/{id} {
      allow read: if consorciosVisualizar() && documentoAcessivel(resource.data);
      allow create: if consorciosEditar() && documentoAcessivel(request.resource.data);
      allow update: if consorciosEditar() && documentoAcessivel(resource.data) && request.resource.data.grupoId == resource.data.grupoId && request.resource.data.empresaId == resource.data.empresaId;
      allow delete: if false;
    }

    match /premissasPlanejamento/{id} {
      allow read: if permissao('controladoria','visualizar') && documentoAcessivel(resource.data);
      allow create: if fpaPremissas() && documentoAcessivel(request.resource.data);
      allow update: if fpaPremissas() && documentoAcessivel(resource.data) && request.resource.data.grupoId == resource.data.grupoId && request.resource.data.empresaId == resource.data.empresaId;
      allow delete: if false;
    }

    match /realizadoMensal/{id} {
      allow read: if permissao('controladoria','visualizar') && documentoAcessivel(resource.data);
      allow create: if fpaRealizado() && documentoAcessivel(request.resource.data);
      allow update: if fpaRealizado() && documentoAcessivel(resource.data) && request.resource.data.grupoId == resource.data.grupoId && request.resource.data.empresaId == resource.data.empresaId;
      allow delete: if false;
    }

    match /inadimplenciaTitulos/{id} {
      allow read: if inadimplenciaVisualizar() && documentoAcessivel(resource.data);
      allow create: if inadimplenciaEditar() && documentoAcessivel(request.resource.data);
      allow update: if inadimplenciaEditar() && documentoAcessivel(resource.data) &&
        request.resource.data.grupoId == resource.data.grupoId &&
        request.resource.data.empresaId == resource.data.empresaId;
      allow delete: if false;
    }

    match /budgetLinhas/{id} {
      allow read: if permissao('controladoria','visualizar') && documentoAcessivel(resource.data);
      allow create: if fpaBudget() && documentoAcessivel(request.resource.data);
      allow update: if fpaBudget() && documentoAcessivel(resource.data) && request.resource.data.grupoId == resource.data.grupoId && request.resource.data.empresaId == resource.data.empresaId;
      allow delete: if false;
    }

    match /forecastLinhas/{id} {
      allow read: if permissao('controladoria','visualizar') && documentoAcessivel(resource.data);
      allow create: if fpaForecast() && documentoAcessivel(request.resource.data);
      allow update: if fpaForecast() && documentoAcessivel(resource.data) && request.resource.data.grupoId == resource.data.grupoId && request.resource.data.empresaId == resource.data.empresaId;
      allow delete: if false;
    }

    match /classificacoesContas/{id} {
      allow read: if permissao('controladoria','visualizar') && documentoAcessivel(resource.data);
      allow create: if (fpaPlano() || fpaBudget()) && documentoAcessivel(request.resource.data);
      allow update: if (fpaPlano() || fpaBudget()) && documentoAcessivel(resource.data) && request.resource.data.grupoId == resource.data.grupoId && request.resource.data.empresaId == resource.data.empresaId;
      allow delete: if false;
    }

    match /planejamentoDetalhes/{id} {
      allow read: if permissao('controladoria','visualizar') && documentoAcessivel(resource.data);
      allow create: if ((request.resource.data.cenario == 'budget' && fpaBudget()) || (request.resource.data.cenario == 'forecast' && fpaForecast()) || fpaEditar()) && documentoAcessivel(request.resource.data);
      allow update: if ((resource.data.cenario == 'budget' && fpaBudget()) || (resource.data.cenario == 'forecast' && fpaForecast()) || fpaEditar()) && documentoAcessivel(resource.data) && request.resource.data.grupoId == resource.data.grupoId && request.resource.data.empresaId == resource.data.empresaId;
      allow delete: if false;
    }

    match /contasBancarias/{id} {
      allow read: if caixaVisualizar() && documentoAcessivel(resource.data);
      allow create: if caixaContas() && documentoAcessivel(request.resource.data);
      allow update: if caixaContas() && documentoAcessivel(resource.data) && request.resource.data.grupoId == resource.data.grupoId && request.resource.data.empresaId == resource.data.empresaId;
      allow delete: if false;
    }

    match /fluxoCaixaLancamentos/{id} {
      allow read: if caixaVisualizar() && documentoAcessivel(resource.data);
      allow create: if caixaLancar() && documentoAcessivel(request.resource.data);
      allow update: if caixaLancar() && documentoAcessivel(resource.data) && request.resource.data.grupoId == resource.data.grupoId && request.resource.data.empresaId == resource.data.empresaId;
      allow delete: if false;
    }

    match /fluxoCaixaFixos/{id} {
      allow read: if caixaVisualizar() && documentoAcessivel(resource.data);
      allow create: if caixaFixos() && documentoAcessivel(request.resource.data);
      allow update: if caixaFixos() && documentoAcessivel(resource.data) && request.resource.data.grupoId == resource.data.grupoId && request.resource.data.empresaId == resource.data.empresaId;
      allow delete: if false;
    }

    match /prestacaoContas/{id} {
      allow read: if permissao('controladoria','visualizar') && documentoAcessivel(resource.data);
      allow create: if prestacaoComentar() && documentoAcessivel(request.resource.data);
      allow update: if prestacaoComentar() && documentoAcessivel(resource.data) && request.resource.data.grupoId == resource.data.grupoId && request.resource.data.empresaId == resource.data.empresaId;
      allow delete: if false;
    }

    match /prestacaoComentarios/{id} {
      allow read: if permissao('controladoria','visualizar') && documentoAcessivel(resource.data);
      allow create: if prestacaoComentar() && documentoAcessivel(request.resource.data);
      allow update: if prestacaoComentar() && documentoAcessivel(resource.data) && request.resource.data.grupoId == resource.data.grupoId && request.resource.data.empresaId == resource.data.empresaId;
      allow delete: if false;
    }

    match /fechamentoTarefas/{id} {
      allow read: if permissao('controladoria','visualizar') && documentoAcessivel(resource.data);
      allow create: if fechamentoGerir() && documentoAcessivel(request.resource.data) && responsavelValido(request.resource.data.responsavelId);
      allow update: if documentoAcessivel(resource.data) &&
        request.resource.data.grupoId == resource.data.grupoId &&
        request.resource.data.empresaId == resource.data.empresaId &&
        request.resource.data.competencia == resource.data.competencia &&
        responsavelValido(request.resource.data.responsavelId) && (
          fechamentoGerir() ||
          ((resource.data.responsavelId == request.auth.uid || fechamentoFechar()) &&
            request.resource.data.responsavelId == resource.data.responsavelId &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','observacao','atualizadoEm']))
        );
      allow delete: if false;
    }

    match /fechamentosMensais/{id} {
      allow read: if permissao('controladoria','visualizar') && documentoAcessivel(resource.data);
      allow create: if (fechamentoGerir() || fechamentoFechar()) && documentoAcessivel(request.resource.data);
      allow update: if fechamentoFechar() && documentoAcessivel(resource.data) && request.resource.data.grupoId == resource.data.grupoId && request.resource.data.empresaId == resource.data.empresaId && request.resource.data.competencia == resource.data.competencia;
      allow delete: if false;
    }

    match /configuracoesControladoria/{id} {
      allow read: if (permissao('controladoria','visualizar') || governancaVisualizar()) && documentoAcessivel(resource.data);
      allow create: if documentoAcessivel(request.resource.data) && (
        fpaEditar() ||
        (governancaConfigurar() && request.resource.data.keys().hasOnly([
          'grupoId','empresaId','criadoPor','criadoEm','atualizadoEm',
          'complianceObrigacoes','complianceRiscos','complianceProgramasAuditoria','complianceCiclosAuditoria'
        ]))
      );
      allow update: if documentoAcessivel(resource.data) &&
        request.resource.data.grupoId == resource.data.grupoId &&
        request.resource.data.empresaId == resource.data.empresaId && (
          fpaEditar() ||
          (governancaConfigurar() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'complianceObrigacoes','complianceRiscos','complianceProgramasAuditoria','complianceCiclosAuditoria','atualizadoEm'
          ])) ||
          (governancaPlanoAcao() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'complianceCiclosAuditoria','atualizadoEm'
          ]))
        );
      allow delete: if false;
    }

    match /permutas/{id} {
      allow read: if permutasVisualizar() && documentoAcessivel(resource.data);
      allow create: if permutasCadastrar() && documentoAcessivel(request.resource.data);
      allow update: if (permutasEditar() || permutasInativar() || permutasFechar()) &&
        documentoAcessivel(resource.data) &&
        request.resource.data.grupoId == resource.data.grupoId &&
        request.resource.data.empresaId == resource.data.empresaId;
      allow delete: if administrador() && documentoAcessivel(resource.data);
    }

    match /permutaMovimentos/{id} {
      allow read: if permutasVisualizar() && documentoAcessivel(resource.data);
      allow create: if (permutasMovimentar() || permutasFechar()) && documentoAcessivel(request.resource.data);
      allow update: if permutasEstornar() && documentoAcessivel(resource.data) &&
        request.resource.data.grupoId == resource.data.grupoId &&
        request.resource.data.empresaId == resource.data.empresaId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'estornado','motivoEstorno','estornadoPor','estornadoPorNome','estornadoEm','atualizadoEm'
        ]);
      allow delete: if administrador() && documentoAcessivel(resource.data);
    }

    match /permutaFechamentos/{id} {
      allow read: if permutasVisualizar() && documentoAcessivel(resource.data);
      allow create: if permutasFechar() && documentoAcessivel(request.resource.data);
      allow update: if false;
      allow delete: if administrador() && documentoAcessivel(resource.data);
    }

    match /planosAcao/{id} {
      allow read: if documentoAcessivel(resource.data) && (
        resource.data.responsavelId == request.auth.uid ||
        resource.data.criadoPor == request.auth.uid ||
        permissao('planosAcao','visualizar')
      );
      allow create: if documentoAcessivel(request.resource.data) &&
        request.resource.data.criadoPor == request.auth.uid &&
        responsavelValido(request.resource.data.responsavelId) &&
        (request.resource.data.responsavelId == request.auth.uid || permissao('planosAcao','cadastrar'));
      allow update: if documentoAcessivel(resource.data) &&
        request.resource.data.grupoId == resource.data.grupoId &&
        request.resource.data.empresaId == resource.data.empresaId &&
        responsavelValido(request.resource.data.responsavelId) && (
          permissao('planosAcao','editar') ||
          (permissao('planosAcao','reatribuir') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['responsavelId','responsavelNome','atualizadoEm'])) ||
          ((resource.data.responsavelId == request.auth.uid || permissao('planosAcao','concluir')) &&
            request.resource.data.responsavelId == resource.data.responsavelId &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','concluidoEm','atualizadoEm']))
        );
      allow delete: if false;
    }
  }
}
