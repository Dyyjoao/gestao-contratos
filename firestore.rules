              'competencia','modelo','avaliadoId','avaliadores','atualizadoEm']))
        );
      allow delete: if false;
    }
    function rhAvaliacaoPlanejada(d) {
      return d.cicloId is string && exists(rhCicloRef(d.cicloId)) &&
        get(rhCicloRef(d.cicloId)).data.status == 'ativo' &&
        get(rhCicloRef(d.cicloId)).data.grupoId == d.grupoId &&
        get(rhCicloRef(d.cicloId)).data.empresaId == d.empresaId &&
        get(rhCicloRef(d.cicloId)).data.competencia == d.ciclo &&
        get(rhCicloRef(d.cicloId)).data.modelo == d.modelo &&
        get(rhCicloRef(d.cicloId)).data.avaliadoId == d.avaliadoId &&
        d.avaliadorChave is string && d.avaliadorChave in get(rhCicloRef(d.cicloId)).data.avaliadores &&
        get(rhCicloRef(d.cicloId)).data.avaliadores[d.avaliadorChave].papel == d.papel &&
        get(rhCicloRef(d.cicloId)).data.avaliadores[d.avaliadorChave].colaboradorId == d.avaliadorId &&
        (d.papel in ['CLIENTE','FORNECEDOR'] ?
          get(rhCicloRef(d.cicloId)).data.avaliadores[d.avaliadorChave].nome == d.avaliadorExternoNome :
          d.avaliadorExternoNome == '');
    }
    function rhModeloPapelValido(d) {
      return d.modelo is string && d.modelo in ['90','180','360','540'] && (
        (d.modelo == '90' && d.papel == 'LIDERANÇA') ||
        (d.modelo == '180' && d.papel in ['LIDERANÇA','AUTOAVALIAÇÃO']) ||
        (d.modelo == '360' && d.papel in ['LIDERANÇA','AUTOAVALIAÇÃO','PAR','LIDERADO']) ||
        (d.modelo == '540' && d.papel in ['LIDERANÇA','AUTOAVALIAÇÃO','PAR','LIDERADO','CLIENTE','FORNECEDOR'])
      );
    }
    function rhAvaliadorValido(d) {
      return (
        d.papel in ['CLIENTE','FORNECEDOR'] &&
        d.avaliadorId is string && d.avaliadorId == '' &&
        d.avaliadorExternoNome is string && d.avaliadorExternoNome.size() > 0 && d.avaliadorExternoNome.size() <= 120
      ) || (
        d.papel in ['AUTOAVALIAÇÃO','LIDERANÇA','PAR','LIDERADO'] &&
        d.avaliadorId is string && d.avaliadorId.size() > 0 &&
        exists(rhColaboradorRef(d.avaliadorId)) &&
        get(rhColaboradorRef(d.avaliadorId)).data.grupoId == d.grupoId &&
        get(rhColaboradorRef(d.avaliadorId)).data.empresaId == d.empresaId &&
        d.avaliadorExternoNome is string && d.avaliadorExternoNome == ''
      );
    }
    function rhAvaliacaoValida(d) {
      return rhMesValido(d.ciclo) && d.avaliadoId is string &&
        exists(rhColaboradorRef(d.avaliadoId)) &&
        get(rhColaboradorRef(d.avaliadoId)).data.grupoId == d.grupoId &&
        get(rhColaboradorRef(d.avaliadoId)).data.empresaId == d.empresaId &&
        rhModeloPapelValido(d) && rhAvaliadorValido(d) &&
        (!('cicloId' in d) || rhAvaliacaoPlanejada(d)) &&
        ((d.papel == 'AUTOAVALIAÇÃO') == (d.avaliadoId == d.avaliadorId)) &&
        d.notas is list && d.notas.size() == 5 &&
        d.notas[0] is int && d.notas[0] >= 1 && d.notas[0] <= 5 &&
        d.notas[1] is int && d.notas[1] >= 1 && d.notas[1] <= 5 &&
        d.notas[2] is int && d.notas[2] >= 1 && d.notas[2] <= 5 &&
        d.notas[3] is int && d.notas[3] >= 1 && d.notas[3] <= 5 &&
        d.notas[4] is int && d.notas[4] >= 1 && d.notas[4] <= 5 &&
        d.comentario is string && d.comentario.size() <= 1000;
    }
    match /rhAvaliacoes360/{id} {
      allow read: if rhVer('rhAvaliacoes360') && documentoAcessivel(resource.data);
      allow create: if permissao('rhAvaliacoes360','lancar') && documentoAcessivel(request.resource.data) &&
        request.resource.data.status == 'ativo' && request.resource.data.registradoPor == request.auth.uid &&
        rhAvaliacaoValida(request.resource.data);
      allow update: if documentoAcessivel(resource.data) && resource.data.status == 'ativo' &&
