        );
      allow delete: if administrador() && documentoAcessivel(resource.data);
    }
    function rhAcaoValida(d) {
      return rhMesValido(d.competencia) && rhDataValida(d.prazo) &&
        d.prazo.matches(d.competencia + '-.*') &&
        d.tipo in ['ENDOMARKETING','MELHORIA','TREINAMENTO'] &&
        d.titulo is string && d.titulo.size() > 0 && d.titulo.size() <= 140 &&
        d.descricao is string && d.descricao.size() <= 1000 &&
        d.situacao in ['PLANEJADA','EM_ANDAMENTO','CONCLUIDA','CANCELADA'] &&
        d.participanteIds is list && d.participanteIds.size() <= 100 &&
        d.participanteUsuarios is list && d.participanteUsuarios.size() <= 100 &&
        (d.tipo == 'ENDOMARKETING' || d.participanteIds.size() > 0);
