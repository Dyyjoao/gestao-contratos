    function moduloIndicador(colecao) {
      return colecao == 'rhHorasExtras' ? 'modhoras' :
        colecao == 'rhQuadro' ? 'modquadro' :
        colecao == 'rhAtivosSetor' ? 'modsetores' :
        colecao == 'rhAtivosMes' ? 'modativos' :
        colecao == 'segurancaOcorrencias' ? 'modincidentes' : 'modtreinamentos';
    }
    function colecaoIndicador(colecao) {
      return colecao in ['rhHorasExtras','rhQuadro','rhAtivosSetor','rhAtivosMes',
        'segurancaOcorrencias','segurancaTreinamentos'];
    }
    function indicadorValido(colecao, dados) {
      return dados.data is string && dados.data.size() == 10 && (
        (colecao == 'rhHorasExtras' &&
          dados.setor in ['LAJE','MANUTENÇÃO','MOURÃO','LOGISTICA','PRODUÇÃO'] &&
          dados.horas50 is number && dados.horas50 >= 0 &&
          dados.horas100 is number && dados.horas100 >= 0 &&
          dados.valor is number && dados.valor >= 0) ||
        (colecao == 'rhQuadro' &&
          dados.admissoes is int && dados.admissoes >= 0 &&
          dados.demissoes is int && dados.demissoes >= 0 &&
          dados.atestados is int && dados.atestados >= 0 &&
          dados.afastamentos is int && dados.afastamentos >= 0) ||
        (colecao == 'rhAtivosSetor' &&
          dados.setor in ['ADM','LAJE','COMERCIAL','LOGISTICA','PRODUÇÃO','MOURÃO','MANUTENÇÃO'] &&
          dados.quantidade is int && dados.quantidade >= 0) ||
        (colecao == 'rhAtivosMes' && dados.quantidade is int && dados.quantidade >= 0) ||
        (colecao == 'segurancaOcorrencias' &&
          dados.tipo in ['ACIDENTE DE TRABALHO','ACIDENTE DE TRAJETO'] &&
          dados.quantidade is int && dados.quantidade >= 0) ||
        (colecao == 'segurancaTreinamentos' &&
          dados.setor in ['Produção','Comercial','Logistica','Financeiro','RH'] &&
          dados.tipoTreinamento is string && dados.tipoTreinamento.size() > 0 &&
          dados.nome is string && dados.nome.size() > 0 &&
          dados.publico in ['MOTORISTAS','GESTORES','TODOS COLABORADORES','ADMINISTRATIVO','TODOS'] &&
          dados.cargaHoraria is number && dados.cargaHoraria >= 0 &&
          dados.custoTotal is number && dados.custoTotal >= 0)
      );
    }
    match /{colecao}/{id} {
      allow read: if colecaoIndicador(colecao) &&
