    function rhVer(modulo) { return permissao(modulo,'visualizar') || permissao(modulo,'lancar') || permissao(modulo,'editar'); }
    function rhSetorValido(setor) { return setor is string && setor.size() > 0 && setor.size() <= 80; }
    function rhDataValida(data) { return data is string && data.size() == 10; }
    function rhMesValido(mes) { return mes is string && mes.size() == 7; }
    function rhColaboradorRef(id) { return /databases/$(database)/documents/rhColaboradores/$(id); }
    function rhColaboradorValido(dados) {
      return dados.codigo is string && dados.codigo.size() > 0 && dados.codigo.size() <= 40 &&
        dados.nome is string && dados.nome.size() > 0 && dados.nome.size() <= 120 &&
        dados.cargoId is string && dados.cargoId.size() <= 80 &&
        dados.cargoNome is string && dados.cargoNome.size() <= 80 &&
        rhSetorValido(dados.setor) && rhDataValida(dados.admissao) &&
        dados.demissao is string && (dados.demissao == '' || (rhDataValida(dados.demissao) && dados.demissao >= dados.admissao)) &&
        dados.jornadaMensalHoras is number && dados.jornadaMensalHoras > 0 && dados.jornadaMensalHoras <= 300 &&
        dados.usuarioId is string && (dados.usuarioId == '' || (
          exists(/databases/$(database)/documents/usuarios/$(dados.usuarioId)) &&
          get(/databases/$(database)/documents/usuarios/$(dados.usuarioId)).data.ativo == true &&
          get(/databases/$(database)/documents/usuarios/$(dados.usuarioId)).data.grupoId == dados.grupoId &&
          (get(/databases/$(database)/documents/usuarios/$(dados.usuarioId)).data.empresaId == dados.empresaId ||
            (('acessoGlobal' in get(/databases/$(database)/documents/usuarios/$(dados.usuarioId)).data) &&
            get(/databases/$(database)/documents/usuarios/$(dados.usuarioId)).data.acessoGlobal == true) ||
            (('empresasAcesso' in get(/databases/$(database)/documents/usuarios/$(dados.usuarioId)).data) &&
              dados.empresaId in get(/databases/$(database)/documents/usuarios/$(dados.usuarioId)).data.empresasAcesso))
        ));
    }
    function rhVinculoValido(dados) {
      return dados.colaboradorId is string && exists(rhColaboradorRef(dados.colaboradorId)) &&
        get(rhColaboradorRef(dados.colaboradorId)).data.grupoId == dados.grupoId &&
        get(rhColaboradorRef(dados.colaboradorId)).data.empresaId == dados.empresaId &&
        get(rhColaboradorRef(dados.colaboradorId)).data.status == 'ativo' &&
        dados.setor == get(rhColaboradorRef(dados.colaboradorId)).data.setor &&
        dados.data >= get(rhColaboradorRef(dados.colaboradorId)).data.admissao &&
        (get(rhColaboradorRef(dados.colaboradorId)).data.demissao == '' ||
          dados.data <= get(rhColaboradorRef(dados.colaboradorId)).data.demissao);
    }
    function rhEventoValido(colecao,dados) {
      return rhDataValida(dados.data) && rhSetorValido(dados.setor) && rhVinculoValido(dados) && (
        (colecao == 'rhAusencias' && dados.tipo in ['FALTA','ATESTADO','ATRASO','AFASTAMENTO','OUTROS'] &&
          dados.horas is number && dados.horas > 0 && dados.horas <= 300 &&
          dados.observacao is string && dados.observacao.size() <= 200) ||
        (colecao == 'rhHorasColaboradores' && dados.horas50 is number && dados.horas50 >= 0 &&
          dados.horas100 is number && dados.horas100 >= 0 &&
          dados.horas50 + dados.horas100 > 0 && dados.horas50 + dados.horas100 <= 300)
      );
    }
    match /rhColaboradores/{id} {
      allow read: if rhVer('rhColaboradores') && documentoAcessivel(resource.data);
      allow create: if permissao('rhColaboradores','lancar') && documentoAcessivel(request.resource.data) &&
        request.resource.data.status == 'ativo' && request.resource.data.registradoPor == request.auth.uid &&
        rhColaboradorValido(request.resource.data);
      allow update: if documentoAcessivel(resource.data) && resource.data.status == 'ativo' &&
        request.resource.data.grupoId == resource.data.grupoId &&
        request.resource.data.empresaId == resource.data.empresaId &&
        request.resource.data.registradoPor == resource.data.registradoPor && (
