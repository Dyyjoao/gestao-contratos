rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }
    function usuarioRef() { return /databases/$(database)/documents/usuarios/$(request.auth.uid); }
    function usuarioExiste() { return logado() && exists(usuarioRef()); }
    function usuario() { return get(usuarioRef()); }
    function usuarioAtivo() { return usuarioExiste() && usuario().data.ativo == true; }
    function perfilRef() { return /databases/$(database)/documents/perfisAcesso/$(usuario().data.perfilId); }
    function perfilExiste() { return usuarioAtivo() && exists(perfilRef()); }
    function perfil() { return get(perfilRef()); }
    function perfilAtivo() { return perfilExiste() && perfil().data.ativo == true; }
    function administrador() { return perfilAtivo() && perfil().data.acessoTotal == true; }

    function permissao(modulo, acao) {
      return perfilAtivo() && (
        administrador() || (
          perfil().data.permissoes is map &&
          modulo in perfil().data.permissoes &&
          perfil().data.permissoes[modulo] is map &&
          acao in perfil().data.permissoes[modulo] &&
          perfil().data.permissoes[modulo][acao] == true
        )
      );
    }

    function mesmoGrupo(grupoId) { return usuarioAtivo() && usuario().data.grupoId == grupoId; }
    function acessoGlobal() { return usuarioAtivo() && ('acessoGlobal' in usuario().data) && usuario().data.acessoGlobal == true; }
    function acessoEmpresa(empresaId) {
      return usuarioAtivo() && (
        administrador() || acessoGlobal() ||
        usuario().data.empresaId == empresaId ||
        (('empresasAcesso' in usuario().data) && usuario().data.empresasAcesso is list && empresaId in usuario().data.empresasAcesso)
      );
    }
    function documentoAcessivel(dados) { return mesmoGrupo(dados.grupoId) && acessoEmpresa(dados.empresaId); }

    function podeAtribuirPerfil(perfilId) {
      return administrador() || (
        perfilId != 'administrador' &&
        exists(/databases/$(database)/documents/perfisAcesso/$(perfilId)) &&
        get(/databases/$(database)/documents/perfisAcesso/$(perfilId)).data.acessoTotal != true &&
        get(/databases/$(database)/documents/perfisAcesso/$(perfilId)).data.grupoId == usuario().data.grupoId
      );
    }

    function responsavelValido(usuarioId) {
      return exists(/databases/$(database)/documents/usuarios/$(usuarioId)) &&
        get(/databases/$(database)/documents/usuarios/$(usuarioId)).data.ativo == true &&
        get(/databases/$(database)/documents/usuarios/$(usuarioId)).data.grupoId == usuario().data.grupoId;
    }

    function fpaEditar() { return permissao('controladoria','editar'); }
    function fpaRealizado() { return fpaEditar() || permissao('controladoria','realizado') || permissao('controladoria','importar'); }
    function fpaBudget() { return fpaEditar() || permissao('controladoria','budget'); }
    function fpaForecast() { return fpaEditar() || permissao('controladoria','forecast'); }
    function fpaPremissas() { return fpaEditar() || permissao('controladoria','premissas'); }
    function fpaPlano() { return fpaEditar() || permissao('controladoria','planoContas'); }
    function fpaCentros() { return fpaEditar() || permissao('controladoria','centrosCusto'); }
    function fpaImobilizado() { return fpaEditar() || permissao('controladoria','imobilizado'); }
    function inadimplenciaVisualizar() { return fpaEditar() || permissao('controladoria','inadimplencia') || permissao('controladoria','inadimplenciaEditar'); }
    function inadimplenciaEditar() { return fpaEditar() || permissao('controladoria','inadimplenciaEditar'); }
    function consorciosVisualizar() { return fpaEditar() || permissao('controladoria','consorciosVisualizar') || permissao('controladoria','consorciosEditar'); }
    function consorciosEditar() { return fpaEditar() || permissao('controladoria','consorciosEditar'); }

    function permutasVisualizar() {
      return permissao('permutas','visualizar') ||
        permissao('permutas','cadastrar') ||
        permissao('permutas','editar') ||
        permissao('permutas','movimentar') ||
        permissao('permutas','estornar') ||
        permissao('permutas','fechar') ||
        permissao('permutas','inativar');
    }
    function permutasCadastrar() { return permissao('permutas','cadastrar'); }
    function permutasEditar() { return permissao('permutas','editar'); }
    function permutasMovimentar() { return permissao('permutas','movimentar'); }
    function permutasEstornar() { return permissao('permutas','estornar'); }
    function permutasFechar() { return permissao('permutas','fechar'); }
    function permutasInativar() { return permissao('permutas','inativar'); }

    function vendasVisualizar() {
      return permissao('vendas','visualizar') ||
        permissao('vendas','lancar') ||
        permissao('vendas','editar') ||
        permissao('vendas','vendedores') ||
        permissao('vendas','comissoes');
    }
    function vendasLancar() { return permissao('vendas','lancar'); }
    function vendasEditar() { return permissao('vendas','editar'); }
    function vendasVendedores() { return permissao('vendas','vendedores'); }
    function vendasComissoes() { return permissao('vendas','comissoes'); }
    function vendedorRef(vendedorId) { return /databases/$(database)/documents/vendedores/$(vendedorId); }
    function vendedorValidoParaVenda(dados) {
      return exists(vendedorRef(dados.vendedorId)) &&
        get(vendedorRef(dados.vendedorId)).data.grupoId == dados.grupoId &&
        get(vendedorRef(dados.vendedorId)).data.empresaId == dados.empresaId &&
        get(vendedorRef(dados.vendedorId)).data.status != 'inativo' &&
        (!('tipoComissao' in get(vendedorRef(dados.vendedorId)).data) ||
          get(vendedorRef(dados.vendedorId)).data.tipoComissao == 'vendedor');
    }
    function valorRecebidoVenda(dados) {
      return 'valorRecebido' in dados ? dados.valorRecebido :
        ('valorFaturado' in dados ? dados.valorFaturado : 0);
    }
    function dataRecebimentoVenda(dados) {
      return 'dataRecebimento' in dados ? dados.dataRecebimento :
        ('dataFaturamento' in dados ? dados.dataFaturamento : '');
    }
    function regraComissaoPadraoValida(dados) {
      return vendedorValidoParaVenda(dados) &&
        dados.baseComissao == get(vendedorRef(dados.vendedorId)).data.baseComissao &&
        dados.comissaoPct == get(vendedorRef(dados.vendedorId)).data.comissaoPct;
    }
    function calculoComissaoValido(dados) {
      return dados.valor > 0 &&
        valorRecebidoVenda(dados) >= 0 && valorRecebidoVenda(dados) <= dados.valor &&
        dados.baseComissao in ['recebido','faturamento','venda'] &&
        dados.comissaoPct >= 0 && dados.comissaoPct <= 100 &&
        dados.comissaoBaseValor == (
          dados.baseComissao in ['recebido','faturamento'] ? valorRecebidoVenda(dados) : dados.valor
        ) &&
        dados.comissaoValor == dados.comissaoBaseValor * dados.comissaoPct / 100;
    }
    function statusComissaoInicialValido(dados) {
      return (
        dados.baseComissao in ['recebido','faturamento'] &&
        valorRecebidoVenda(dados) <= 0 &&
        dados.comissaoStatus in ['aguardando_recebimento','aguardando_faturamento']
      ) || (
        (dados.baseComissao == 'venda' || valorRecebidoVenda(dados) > 0) &&
        dados.comissaoStatus == 'provisionada'
      );
    }
    function vendaOperacionalValida(novo, antigo) {
      return calculoComissaoValido(novo) && (
        vendasComissoes() || (
          novo.vendedorId == antigo.vendedorId &&
          novo.vendedorNome == antigo.vendedorNome &&
          novo.baseComissao == antigo.baseComissao &&
          novo.comissaoPct == antigo.comissaoPct &&
          novo.comissaoStatus == antigo.comissaoStatus &&
          ((antigo.comissaoStatus != 'aprovada' && antigo.comissaoStatus != 'paga') || (
            novo.valor == antigo.valor &&
            valorRecebidoVenda(novo) == valorRecebidoVenda(antigo) &&
            dataRecebimentoVenda(novo) == dataRecebimentoVenda(antigo)
          ))
        )
      );
    }

    function caixaVisualizar() {
      return permissao('controladoria','visualizar') ||
        permissao('controladoria','caixaVisualizar');
    }
    function caixaLancar() { return fpaEditar() || permissao('controladoria','caixaLancar'); }
    function caixaContas() { return fpaEditar() || permissao('controladoria','caixaContas'); }
    function caixaFixos() { return fpaEditar() || permissao('controladoria','caixaFixos'); }
    function prestacaoComentar() { return fpaEditar() || permissao('controladoria','prestacaoComentar'); }
    function fechamentoGerir() { return fpaEditar() || permissao('controladoria','fechamento'); }
    function fechamentoFechar() { return fpaEditar() || permissao('controladoria','fecharCompetencia'); }

    function contasPagarVisualizar() {
      return permissao('contasPagar','visualizar') ||
        permissao('contasPagar','cadastrar') ||
        permissao('contasPagar','editar') ||
        permissao('contasPagar','baixar');
    }
    function contasPagarCadastrar() { return permissao('contasPagar','cadastrar') || permissao('contasPagar','editar'); }
    function contasPagarEditar() { return permissao('contasPagar','editar'); }
    function contasPagarBaixar() { return permissao('contasPagar','baixar') || contasPagarEditar(); }

    function frotaVisualizar() {
      return permissao('frota','visualizar') || permissao('frota','cadastrar') ||
        permissao('frota','editar') || permissao('frota','manutencao') || permissao('frota','obrigacoes');
    }
    function frotaEditar() { return permissao('frota','editar'); }
    function frotaManutencao() { return permissao('frota','manutencao') || frotaEditar(); }
    function frotaObrigacoes() { return permissao('frota','obrigacoes') || frotaEditar(); }
    function frotaUpdateEscopoValido() {
      return documentoAcessivel(resource.data) &&
        request.resource.data.grupoId == resource.data.grupoId &&
        request.resource.data.empresaId == resource.data.empresaId;
    }
    function frotaFichaOperacionalValida() {
      return frotaEditar() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'placa','renavam','marca','modelo','anoModelo','status','quilometragemInicial','quilometragemAtual','dataAquisicao','valorAquisicao',
        'responsavel','centroCustoDescricao','observacoes','ultimaConsultaOficialEm','proximaConsultaOficialEm','atualizadoEm'
      ]);
    }
    function frotaObrigacaoUpdateValida() {
      return frotaObrigacoes() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'obrigacoes','ultimaConsultaOficialEm','proximaConsultaOficialEm','atualizadoEm'
      ]);
    }
    function frotaKmUpdateValida() {
      return frotaManutencao() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quilometragemAtual','atualizadoEm']);
    }
    function frotaPatrimonioUpdateValido() {
      return fpaImobilizado() && frotaEditar() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'contaAtivoId','contaDepreciacaoAcumuladaId','contaDepreciacaoId','vidaUtilMeses','dataDisponivelUso',
        'integrarPlanejamento','imobilizadoId','atualizadoEm'
      ]);
    }

    function governancaVisualizar() {
      return permissao('governanca','visualizar') ||
        permissao('governanca','antifraude') ||
        permissao('governanca','auditar') ||
        permissao('governanca','planoAcao') ||
        permissao('governanca','validar') ||
        permissao('governanca','configurar');
    }
    function governancaConfigurar() { return permissao('governanca','configurar'); }
    function governancaAuditar() { return governancaConfigurar() || permissao('governanca','auditar') || permissao('governanca','validar'); }
    function governancaPlanoAcao() { return governancaAuditar() || permissao('governanca','planoAcao'); }
    function gerenciaUsuarios() { return permissao('usuarios','visualizar') || permissao('usuarios','cadastrar') || permissao('usuarios','editar'); }
    function usaCentroCusto() {
      return permissao('controladoria','visualizar') ||
        permissao('contratos','visualizar') ||
        permissao('almoxarifado','visualizar') ||
        permissao('cotacoes','visualizar') ||
        frotaVisualizar() ||
        permutasVisualizar();
    }

    match /usuarios/{usuarioId} {
      allow read: if logado() && (
        request.auth.uid == usuarioId ||
        ((permissao('usuarios','visualizar') || permissao('rhColaboradores','lancar') || permissao('rhColaboradores','editar') || permissao('planosAcao','reatribuir') || permissao('controladoria','fechamento')) && resource.data.grupoId == usuario().data.grupoId)
      );
      allow create: if permissao('usuarios','cadastrar') && request.resource.data.grupoId == usuario().data.grupoId && podeAtribuirPerfil(request.resource.data.perfilId);
      allow update: if resource.data.grupoId == usuario().data.grupoId && request.resource.data.grupoId == resource.data.grupoId && podeAtribuirPerfil(request.resource.data.perfilId) && (
        (permissao('usuarios','editar') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome','perfilId','empresaId','acessoGlobal','empresasAcesso','atualizadoEm'])) ||
        (permissao('usuarios','inativar') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ativo','atualizadoEm']))
      );
      allow delete: if false;
    }

    match /configuracoesModulos/{id} {
      allow read: if usuarioAtivo() && documentoAcessivel(resource.data);
      allow create: if administrador() && documentoAcessivel(request.resource.data) &&
        request.resource.data.modulo is string && request.resource.data.modulo.size() > 0;
      allow update: if administrador() && documentoAcessivel(resource.data) &&
        request.resource.data.grupoId == resource.data.grupoId &&
        request.resource.data.empresaId == resource.data.empresaId &&
        request.resource.data.modulo == resource.data.modulo;
      allow delete: if false;
    }

    match /dashboardPreferencias/{usuarioId} {
      allow read: if usuarioAtivo() && request.auth.uid == usuarioId && resource.data.grupoId == usuario().data.grupoId;
      allow create: if usuarioAtivo() && request.auth.uid == usuarioId &&
        request.resource.data.usuarioId == request.auth.uid &&
        request.resource.data.grupoId == usuario().data.grupoId;
      allow update: if usuarioAtivo() && request.auth.uid == usuarioId &&
        resource.data.usuarioId == request.auth.uid &&
        request.resource.data.usuarioId == resource.data.usuarioId &&
        resource.data.grupoId == usuario().data.grupoId &&
        request.resource.data.grupoId == resource.data.grupoId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ordem','ocultos','atualizadoEm']);
      allow delete: if false;
    }

    match /auditoriaAdministrativa/{id} {
      allow read: if documentoAcessivel(resource.data) && (administrador() || governancaAuditar());
      allow create: if administrador() && documentoAcessivel(request.resource.data) && request.resource.data.usuarioId == request.auth.uid;
      allow update, delete: if false;
    }

    match /perfisAcesso/{perfilId} {
      allow read: if usuarioAtivo() && (
        usuario().data.perfilId == perfilId || administrador() ||
        (permissao('perfisAcesso','visualizar') && (resource.data.acessoTotal == true || !('grupoId' in resource.data) || resource.data.grupoId == usuario().data.grupoId)) ||
        (gerenciaUsuarios() && resource.data.acessoTotal != true && resource.data.grupoId == usuario().data.grupoId)
      );
      allow create: if permissao('perfisAcesso','cadastrar') && request.resource.data.acessoTotal == false && request.resource.data.grupoId == usuario().data.grupoId;
      allow update: if perfilId != 'administrador' && resource.data.acessoTotal != true && request.resource.data.acessoTotal == false && resource.data.grupoId == usuario().data.grupoId && request.resource.data.grupoId == resource.data.grupoId && (
        (permissao('perfisAcesso','editar') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome','descricao','permissoes','atualizadoEm'])) ||
        (permissao('perfisAcesso','inativar') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ativo','atualizadoEm']))
      );
      allow delete: if false;
    }

    match /gruposEmpresariais/{grupoId} {
      allow read: if usuarioAtivo() && usuario().data.grupoId == grupoId;
      allow create: if administrador() && request.resource.data.ativo == true;
      allow update: if mesmoGrupo(grupoId) && permissao('grupoEmpresarial','editar') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome','atualizadoEm']);
      allow delete: if false;
    }

    match /empresas/{empresaId} {
      allow read: if acessoEmpresa(empresaId) && mesmoGrupo(resource.data.grupoId);
      allow create: if permissao('empresas','cadastrar') && request.resource.data.grupoId == usuario().data.grupoId;
      allow update: if mesmoGrupo(resource.data.grupoId) && request.resource.data.grupoId == resource.data.grupoId && (
        (permissao('empresas','editar') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['razaoSocial','nomeFantasia','cnpj','cnpjNumeros','atualizadoEm'])) ||
        (permissao('empresas','inativar') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ativo','atualizadoEm']))
      );
      allow delete: if administrador() && mesmoGrupo(resource.data.grupoId);
    }

    match /contratos/{id} {
      allow read: if permissao('contratos','visualizar') && documentoAcessivel(resource.data);
      allow create: if permissao('contratos','cadastrar') && documentoAcessivel(request.resource.data);
      allow update: if documentoAcessivel(resource.data) && request.resource.data.grupoId == resource.data.grupoId && request.resource.data.empresaId == resource.data.empresaId && (
        permissao('contratos','editar') ||
        (permissao('contratos','anexar') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['arquivoPrincipal','documentos','atualizadoEm']))
      );
      allow delete: if administrador() && documentoAcessivel(resource.data);
    }

    match /prestadores/{id} {
      allow read: if permissao('prestadores','visualizar') && documentoAcessivel(resource.data);
      allow create: if permissao('prestadores','cadastrar') && documentoAcessivel(request.resource.data);
      allow update: if (permissao('prestadores','editar') || permissao('prestadores','avaliar')) && documentoAcessivel(resource.data) && request.resource.data.grupoId == resource.data.grupoId && request.resource.data.empresaId == resource.data.empresaId;
      allow delete: if administrador() && documentoAcessivel(resource.data);
    }

    match /veiculos/{id} {
      allow read: if frotaVisualizar() && documentoAcessivel(resource.data);
      allow create: if permissao('frota','cadastrar') && documentoAcessivel(request.resource.data) && (
        administrador() || fpaImobilizado() || (
          request.resource.data.contaAtivoId == '' &&
          request.resource.data.contaDepreciacaoAcumuladaId == '' &&
          request.resource.data.contaDepreciacaoId == '' &&
          request.resource.data.imobilizadoId == '' &&
          request.resource.data.integrarPlanejamento == false
        )
      );
      allow update: if frotaUpdateEscopoValido() && (
        administrador() || frotaFichaOperacionalValida() || frotaObrigacaoUpdateValida() || frotaKmUpdateValida() || frotaPatrimonioUpdateValido()
      );
      allow delete: if administrador() && documentoAcessivel(resource.data);
    }

    function combustivelVer() {
      return frotaVisualizar() && (permissao('combustivel','visualizar') ||
        permissao('combustivel','lancar') || permissao('combustivel','editar'));
    }
    function movimentoDieselValido(dados) {
      return dados.data is string && dados.data.size() == 10 &&
        dados.placa is string && dados.placa.size() > 0 &&
        dados.motorista is string && dados.motorista.size() > 0 &&
        dados.tipo in ['consumo','recebimento'] &&
        dados.quantidade is number && dados.quantidade > 0 &&
        (dados.kmAnterior == null || (dados.kmAnterior is int && dados.kmAnterior >= 0)) &&
        (dados.kmAtual == null || (dados.kmAtual is int && dados.kmAtual >= 0)) &&
        (dados.kmAnterior == null || dados.kmAtual == null || dados.kmAtual >= dados.kmAnterior) &&
        dados.veiculoId is string &&
        exists(/databases/$(database)/documents/veiculos/$(dados.veiculoId)) &&
        get(/databases/$(database)/documents/veiculos/$(dados.veiculoId)).data.grupoId == dados.grupoId &&
        get(/databases/$(database)/documents/veiculos/$(dados.veiculoId)).data.empresaId == dados.empresaId &&
        get(/databases/$(database)/documents/veiculos/$(dados.veiculoId)).data.placa == dados.placa;
    }
    match /abastecimentosFrota/{id} {
      allow read: if combustivelVer() && documentoAcessivel(resource.data);
      allow create: if permissao('combustivel','lancar') && frotaVisualizar() &&
        documentoAcessivel(request.resource.data) && request.resource.data.status == 'ativo' &&
        request.resource.data.registradoPor == request.auth.uid && movimentoDieselValido(request.resource.data);
      allow update: if documentoAcessivel(resource.data) && resource.data.status == 'ativo' &&
        request.resource.data.grupoId == resource.data.grupoId &&
        request.resource.data.empresaId == resource.data.empresaId &&
        request.resource.data.registradoPor == resource.data.registradoPor &&
        (
          (administrador() && request.resource.data.status == 'estornado' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status','motivoEstorno','estornadoPor','estornadoEm','atualizadoEm'])) ||
          (permissao('combustivel','editar') && frotaVisualizar() &&
            request.resource.data.status == 'ativo' && movimentoDieselValido(request.resource.data) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'data','placa','veiculoId','motorista','tipo','quantidade','kmAnterior','kmAtual','atualizadoEm']))
        );
      allow delete: if false;
    }
    match /custosDiesel/{id} {
      allow read: if combustivelVer() && documentoAcessivel(resource.data);
      allow create: if permissao('combustivel','lancar') && frotaVisualizar() &&
        documentoAcessivel(request.resource.data) && request.resource.data.status == 'ativo' &&
        request.resource.data.registradoPor == request.auth.uid &&
        request.resource.data.data is string && request.resource.data.data.size() == 10 &&
        request.resource.data.nf is string && request.resource.data.nf.size() > 0 && request.resource.data.nf.size() <= 40 &&
        request.resource.data.quantidade is number && request.resource.data.quantidade > 0 &&
        request.resource.data.valorTotal is number && request.resource.data.valorTotal >= 0 &&
        request.resource.data.valor is number && request.resource.data.valor == request.resource.data.valorTotal &&
        request.resource.data.custoLitro is number &&
        request.resource.data.custoLitro == request.resource.data.valorTotal / request.resource.data.quantidade;
      allow update: if documentoAcessivel(resource.data) && resource.data.status == 'ativo' &&
        request.resource.data.grupoId == resource.data.grupoId &&
        request.resource.data.empresaId == resource.data.empresaId &&
        request.resource.data.registradoPor == resource.data.registradoPor && (
          (administrador() && request.resource.data.status == 'estornado' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status','motivoEstorno','estornadoPor','estornadoEm','atualizadoEm'])) ||
          (permissao('combustivel','editar') && frotaVisualizar() &&
            request.resource.data.status == 'ativo' &&
