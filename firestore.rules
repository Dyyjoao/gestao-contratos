            rhColaboradorValido(request.resource.data) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'codigo','nome','setor','cargoId','cargoNome','admissao','demissao','jornadaMensalHoras','usuarioId','atualizadoEm']))
        );
      allow delete: if administrador() && documentoAcessivel(resource.data);
    }
    match /{colecao}/{id} {
      allow read: if colecao in ['rhAusencias','rhHorasColaboradores'] &&
        rhVer(colecao) && documentoAcessivel(resource.data);
      allow create: if colecao in ['rhAusencias','rhHorasColaboradores'] &&
        permissao(colecao,'lancar') && documentoAcessivel(request.resource.data) &&
        request.resource.data.status == 'ativo' && request.resource.data.registradoPor == request.auth.uid &&
        rhEventoValido(colecao,request.resource.data);
      allow update: if colecao in ['rhAusencias','rhHorasColaboradores'] &&
        documentoAcessivel(resource.data) && resource.data.status == 'ativo' &&
        request.resource.data.grupoId == resource.data.grupoId &&
        request.resource.data.empresaId == resource.data.empresaId &&
        request.resource.data.registradoPor == resource.data.registradoPor &&
        request.resource.data.colaboradorId == resource.data.colaboradorId && (
          (administrador() && request.resource.data.status == 'estornado' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status','motivoEstorno','estornadoPor','estornadoEm','atualizadoEm'])) ||
          (permissao(colecao,'editar') && request.resource.data.status == 'ativo' &&
            rhEventoValido(colecao,request.resource.data) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'data','setor','tipo','horas','observacao','horas50','horas100','atualizadoEm']))
        );
      allow delete: if colecao in ['rhAusencias','rhHorasColaboradores'] && administrador() && documentoAcessivel(resource.data);
    }
    function rhCicloRef(id) { return /databases/$(database)/documents/rhCiclosAvaliacao/$(id); }
    function rhCicloValido(d) {
      return rhMesValido(d.competencia) && d.modelo in ['90','180','360','540'] &&
        d.avaliadoId is string && exists(rhColaboradorRef(d.avaliadoId)) &&
        get(rhColaboradorRef(d.avaliadoId)).data.grupoId == d.grupoId &&
        get(rhColaboradorRef(d.avaliadoId)).data.empresaId == d.empresaId &&
        d.avaliadores is map && d.avaliadores.size() > 0 && d.avaliadores.size() <= 50;
    }
    match /rhCiclosAvaliacao/{id} {
      allow read: if rhVer('rhAvaliacoes360') && documentoAcessivel(resource.data);
      allow create: if permissao('rhAvaliacoes360','lancar') && documentoAcessivel(request.resource.data) &&
        request.resource.data.status == 'ativo' && request.resource.data.registradoPor == request.auth.uid &&
        rhCicloValido(request.resource.data);
      allow update: if documentoAcessivel(resource.data) && resource.data.status == 'ativo' &&
        request.resource.data.grupoId == resource.data.grupoId &&
        request.resource.data.empresaId == resource.data.empresaId &&
        request.resource.data.registradoPor == resource.data.registradoPor && (
          (administrador() && request.resource.data.status == 'estornado' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status','motivoEstorno','estornadoPor','estornadoEm','atualizadoEm'])) ||
